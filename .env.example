# Qlar DB Wrapper — configuration
#
# Copy to .env and fill in. Real environment variables take precedence over this file,
# so a container or systemd unit can override any line without editing it.
#
# You do not have to start here: `qlar-db-wrapper run` with no usable configuration asks
# for the database details and writes .env itself, and `--init` asks again later. This
# file is the reference for everything the prompts do not ask about.
#
# This file contains your database password. Keep it mode 0600 and out of version control
# (.gitignore already excludes it).

# ---------------------------------------------------------------------------
# Qlar endpoint
# ---------------------------------------------------------------------------
# The API endpoint, which is not the address of the Qlar web interface — that one serves
# a website and would answer enrolment with a 404. The CMS wrapper panel prints the exact
# value; it ends in /api/db-wrapper.
QLAR_BASE_URL=

# One-time code from the Qlar CMS (agent -> Plugins -> SQL Database Reader -> wrapper).
# Single use, expires 15 minutes after it is generated. Only needed for `enroll`; you can
# delete the line once enrolment has succeeded.
QLAR_ENROLLMENT_CODE=

# Label shown in the CMS. Defaults to this machine's hostname.
#QLAR_WRAPPER_NAME=warehouse-db wrapper

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Use an account with SELECT and nothing more. The wrapper always opens a READ ONLY
# transaction, but a read-only account is the guarantee that does not depend on our code.
DB_PROVIDER=postgresql          # postgresql | mysql | sqlserver | oracle
DB_HOST=db.internal
DB_PORT=5432
DB_NAME=warehouse
DB_USER=qlar_readonly
DB_PASSWORD=

# Extra driver options. Everything after DB_OPT_ is passed to the driver lower-cased:
#DB_OPT_SSLMODE=verify-full     # PostgreSQL
#DB_OPT_SID=ORCL                # Oracle, when connecting by SID instead of service name

# ---------------------------------------------------------------------------
# Limits
# ---------------------------------------------------------------------------
# Server-side statement timeout. A client-side timeout alone would leave the query
# running on your database after the wrapper stopped waiting.
DB_STATEMENT_TIMEOUT_SECONDS=30

# Ceiling on a single result, in bytes. Results cross the public internet on this path,
# which they did not on a direct connection.
MAX_RESULT_BYTES=10485760

# How many queries may run at once. Protects your database from a busy agent.
MAX_CONCURRENT_QUERIES=5

# ---------------------------------------------------------------------------
# Hardening (recommended)
# ---------------------------------------------------------------------------
# When set, ONLY these tables can be read, whatever Qlar asks for. This list lives here,
# on your premises, precisely so that a compromise of Qlar cannot widen it.
# Schema-qualified where your database has schemas; comma separated.
#TABLE_ALLOWLIST=public.shipment_order,public.hub,public.customer

# Your own record of every statement that ran, one JSON object per line. Never leaves this
# machine. Set to empty to disable (not recommended).
AUDIT_LOG_FILE=./audit/queries.jsonl

# ---------------------------------------------------------------------------
# Files and logging
# ---------------------------------------------------------------------------
# The private key identifying this wrapper. Generated on first run with mode 0600.
# Back it up: losing it means enrolling and being approved again.
WRAPPER_KEY_FILE=./wrapper-key.pem

# Wrapper id and the pinned Qlar public key, written at enrolment.
WRAPPER_STATE_FILE=./wrapper-state.json

LOG_LEVEL=INFO

# How long Qlar may hold an idle poll open. Keep at or below 25 so it stays under the
# 30-second idle timeout most corporate proxies impose.
POLL_TIMEOUT_SECONDS=25
